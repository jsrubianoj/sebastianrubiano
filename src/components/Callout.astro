---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<section class="py-20 px-4 sm:px-6 lg:px-8 border-t border-slate-900 bg-slate-900/60 relative">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-xs uppercase tracking-widest text-sky-400 font-bold mb-2">Music &amp; Creative Projects</h2>
    <h3 class="text-3xl font-bold text-white mb-8 tracking-tight">Check Out My Band's Music Video</h3>
    
    <div 
      id="video-wrapper" 
      class="relative aspect-video rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-black group cursor-pointer focus:outline-none focus:ring-2 focus:ring-sky-500"
      tabindex="0"
      role="button"
      aria-label="Play band music video"
    >
      <!-- Custom Video Poster -->
      <img 
        id="video-poster"
        src={`${base}/img/band-poster.jpg`} 
        alt="Sebastián playing guitar with the band" 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
        loading="lazy"
      />

      <!-- Play Button Overlay -->
      <div id="play-button" class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/10 transition-colors pointer-events-none">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600/90 text-white flex items-center justify-center pl-1 shadow-2xl shadow-red-600/50 group-hover:scale-110 group-hover:bg-red-600 transition-all duration-300">
          <i class="fa-solid fa-play text-xl sm:text-2xl"></i>
        </div>
      </div>

      <!-- Container where iframe injects upon click -->
      <div id="iframe-target" class="hidden w-full h-full"></div>
    </div>
  </div>
</section>

<script>
  function setupVideo() {
    const wrapper = document.getElementById('video-wrapper');
    const target = document.getElementById('iframe-target');
    const poster = document.getElementById('video-poster');
    const playBtn = document.getElementById('play-button');

    function playVideo() {
      if (target && target.classList.contains('hidden')) {
        target.innerHTML = `
          <iframe 
            class="w-full h-full"
            src="https://www.youtube.com/embed/O_gNQ2dZd2I?autoplay=1" 
            title="Band Music Video" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen
          ></iframe>
        `;
        target.classList.remove('hidden');
        poster?.classList.add('hidden');
        playBtn?.classList.add('hidden');
        wrapper?.classList.remove('cursor-pointer');
        wrapper?.removeAttribute('tabindex');
        wrapper?.removeAttribute('role');
      }
    }

    wrapper?.addEventListener('click', playVideo, { once: true });
    wrapper?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        playVideo();
      }
    }, { once: true });
  }

  // Support initial load and Astro view transitions
  setupVideo();
  document.addEventListener('astro:after-swap', setupVideo);
</script>
