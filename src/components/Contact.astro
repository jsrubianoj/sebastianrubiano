---
---
<section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 border-t border-slate-900 bg-slate-950">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-xs uppercase tracking-widest text-sky-400 font-bold mb-2">Get In Touch</h2>
    <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Let's Connect</h3>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
      Interested in collaborating on software engineering, BIM &amp; AEC automation, or discussing a new opportunity? Feel free to reach out or book a quick conversation directly on my calendar.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-14">
      <a 
        href="https://cal.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl text-sm font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-all shadow-lg shadow-sky-600/30"
      >
        <i class="fa-regular fa-calendar-check text-base"></i>
        <span>Schedule 15-min Call (Cal.com)</span>
      </a>
      
      <a 
        href="mailto:jsrubianoj@gmail.com" 
        class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl text-sm font-semibold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white transition-all"
      >
        <i class="fa-regular fa-envelope text-base text-sky-400"></i>
        <span>Send Email</span>
      </a>

      <a 
        href="https://github.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl text-sm font-semibold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white transition-all"
      >
        <i class="fa-brands fa-github text-base"></i>
        <span>GitHub</span>
      </a>

      <!-- LinkedIn with Tooltip -->
      <div class="relative group inline-block">
        <button 
          type="button"
          class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl text-sm font-semibold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-300 hover:text-white transition-all cursor-default"
          aria-describedby="contact-linkedin-tooltip"
        >
          <i class="fa-brands fa-linkedin text-base text-[#0a66c2]"></i>
          <span>LinkedIn</span>
        </button>
        <!-- Tooltip -->
        <div 
          id="contact-linkedin-tooltip"
          role="tooltip"
          class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-64 p-3 bg-slate-900/95 border border-slate-700 text-slate-300 text-xs rounded-xl shadow-2xl backdrop-blur-md opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 pointer-events-none z-30 text-center leading-relaxed"
        >
          Stepped away from LinkedIn in 2025 to focus on deep engineering work and direct conversations. Let's connect via email or Cal.com!
          <div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-slate-700"></div>
        </div>
      </div>
    </div>

    <!-- Location Card & City Map -->
    <div class="rounded-2xl border border-slate-800 overflow-hidden shadow-2xl bg-slate-900/60">
      <div class="p-4 sm:p-6 border-b border-slate-800 flex flex-wrap items-center justify-between gap-4 text-left">
        <div>
          <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-1">Based in</div>
          <div class="text-base font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-location-dot text-sky-400"></i>
            <span>Bogotá, Colombia</span>
          </div>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Open to Worldwide Remote &amp; Relocation</span>
        </div>
      </div>

      <div class="h-72 w-full">
        <iframe 
          class="w-full h-full border-0 grayscale contrast-125 opacity-85 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
          src="https://maps.google.com/maps?q=Bogota%2C%20Colombia&t=&z=11&ie=UTF8&iwloc=&output=embed"
          title="Bogotá, Colombia map overview"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>
</section>
