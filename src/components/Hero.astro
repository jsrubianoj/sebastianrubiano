---
---
<section id="top" class="relative min-h-[90vh] flex items-center justify-center pt-24 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Subtle background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-sky-950/40 via-slate-950 to-slate-950 pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-4xl mx-auto text-center">
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-sky-500/30 bg-sky-950/60 text-sky-300 text-xs font-medium mb-8 backdrop-blur-sm shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Available for Software & Engineering Automation Roles</span>
    </div>

    <!-- Name & Role Headline -->
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6">
      Sebastián Rubiano Jara
    </h1>
    
    <p class="text-lg sm:text-2xl text-slate-300 font-medium max-w-3xl mx-auto leading-relaxed mb-8">
      Civil Engineer &amp; Full-Stack Developer bridging physical infrastructure with modern software, BIM automation, and cloud applications.
    </p>

    <!-- Tech Stack Quick Pills -->
    <div class="flex flex-wrap justify-center gap-2 mb-10 max-w-2xl mx-auto text-xs sm:text-sm text-slate-300">
      <span class="px-3 py-1 rounded-md bg-slate-900 border border-slate-800">C# (.NET / Revit API)</span>
      <span class="px-3 py-1 rounded-md bg-slate-900 border border-slate-800">pyRevit &amp; Python</span>
      <span class="px-3 py-1 rounded-md bg-slate-900 border border-slate-800">Dynamo Visual Programming</span>
      <span class="px-3 py-1 rounded-md bg-slate-900 border border-slate-800">ACC / Forge Cloud APIs</span>
      <span class="px-3 py-1 rounded-md bg-slate-900 border border-slate-800">React &amp; Astro</span>
      <span class="px-3 py-1 rounded-md bg-slate-900 border border-slate-800 text-sky-400">📍 Bogotá, Colombia</span>
    </div>

    <!-- Main CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="#automation" 
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-all shadow-lg shadow-sky-600/25 hover:shadow-sky-500/40 text-sm"
      >
        <span>Explore BIM & AEC Tech</span>
        <i class="fa-solid fa-arrow-down text-xs"></i>
      </a>
      <a 
        href="https://cal.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white transition-all text-sm"
      >
        <i class="fa-regular fa-calendar-check text-sky-400"></i>
        <span>Book a 15-min Call</span>
      </a>
      <a 
        href="https://github.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white transition-all text-sm"
      >
        <i class="fa-brands fa-github"></i>
        <span>GitHub Repos</span>
      </a>
    </div>
  </div>
</section>
