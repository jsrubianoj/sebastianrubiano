---
---
<footer class="py-12 px-4 sm:px-6 lg:px-8 border-t border-slate-900 bg-slate-950 text-center">
  <div class="max-w-4xl mx-auto space-y-4">
    <div class="flex items-center justify-center gap-4 text-slate-400">
      <a 
        href="https://github.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full border border-slate-800 bg-slate-900 flex items-center justify-center text-slate-300 hover:text-white hover:border-slate-700 transition-colors"
        aria-label="GitHub"
      >
        <i class="fa-brands fa-github text-lg"></i>
      </a>
      <a 
        href="mailto:jsrubianoj@gmail.com" 
        class="w-10 h-10 rounded-full border border-slate-800 bg-slate-900 flex items-center justify-center text-slate-300 hover:text-white hover:border-slate-700 transition-colors"
        aria-label="Email"
      >
        <i class="fa-regular fa-envelope text-lg"></i>
      </a>
      <a 
        href="https://cal.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full border border-slate-800 bg-slate-900 flex items-center justify-center text-slate-300 hover:text-white hover:border-slate-700 transition-colors"
        aria-label="Cal.com"
      >
        <i class="fa-regular fa-calendar-check text-lg"></i>
      </a>

      <!-- LinkedIn with Tooltip -->
      <div class="relative group inline-block">
        <button 
          type="button"
          class="w-10 h-10 rounded-full border border-slate-800 bg-slate-900 flex items-center justify-center text-slate-400 hover:text-white hover:border-slate-700 transition-colors cursor-default"
          aria-label="LinkedIn"
        >
          <i class="fa-brands fa-linkedin text-lg text-[#0a66c2]"></i>
        </button>
        <!-- Tooltip -->
        <div 
          role="tooltip"
          class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-60 p-3 bg-slate-900/95 border border-slate-700 text-slate-300 text-xs rounded-xl shadow-2xl backdrop-blur-md opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 pointer-events-none z-30 text-center leading-relaxed"
        >
          Stepped away from LinkedIn in 2025 to focus on deep engineering work. Reach out via email or Cal.com!
          <div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-slate-700"></div>
        </div>
      </div>
    </div>

    <p class="text-slate-400 text-sm">
      &copy; {new Date().getFullYear()} Sebastián Rubiano Jara. All rights reserved.
    </p>

    <p class="text-xs text-slate-500 max-w-xl mx-auto leading-relaxed">
      Originally written in 2021 using HTML5, Bootstrap 4, Sass, and jQuery (Start Bootstrap Stylish Portfolio).<br class="hidden sm:inline" />
      Upgraded in 2026 to Astro &amp; Tailwind CSS using Antigravity and Gemini 3.5 Flash.
    </p>
  </div>
</footer>
