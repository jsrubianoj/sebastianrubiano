---
<header class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-2 group">
      <div class="w-9 h-9 rounded-lg bg-sky-600 flex items-center justify-center text-white font-bold text-lg group-hover:bg-sky-500 transition-colors shadow-lg shadow-sky-600/30">
        SR
      </div>
      <span class="font-semibold text-slate-100 tracking-tight group-hover:text-sky-400 transition-colors">
        Sebastián Rubiano
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
      <a href="#about" class="hover:text-white transition-colors">About</a>
      <a href="#automation" class="hover:text-white transition-colors flex items-center gap-1.5 text-sky-400 hover:text-sky-300">
        <i class="fa-solid fa-cube text-xs"></i> BIM & AEC
      </a>
      <a href="#portfolio" class="hover:text-white transition-colors">Portfolio</a>
      <a href="#skills" class="hover:text-white transition-colors">Skills</a>
      <a href="#contact" class="hover:text-white transition-colors">Contact</a>
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-3">
      <a 
        href="https://cal.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-all shadow-md shadow-sky-600/20 hover:shadow-sky-500/30"
      >
        <i class="fa-solid fa-calendar-days text-xs"></i>
        <span>Schedule Call</span>
      </a>
      <a 
        href="https://github.com/jsrubianoj" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 transition-colors"
        aria-label="GitHub Profile"
      >
        <i class="fa-brands fa-github text-lg"></i>
      </a>
    </div>
  </div>
</header>
